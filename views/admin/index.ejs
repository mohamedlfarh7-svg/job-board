<%- include('../partials/header') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <!-- Header & Action Button -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
                Gestion des offres d'emploi
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                Gérez vos annonces, consultez le nombre de candidatures et mettez à jour les postes.
            </p>
        </div>
        <a href="/admin/offres/create" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition">
            <i class="fa-solid fa-plus text-xs"></i> Publier une offre
        </a>
    </div>

    <!-- Table Section -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <% if (!offres || offres.length === 0) { %>
            <div class="p-12 text-center">
                <i class="fa-solid fa-folder-open text-gray-300 text-4xl mb-3 block"></i>
                <p class="text-gray-500 text-sm font-medium">Aucune offre d'emploi n'a été publiée pour le moment.</p>
                <a href="/admin/offres/create" class="inline-block mt-4 text-xs font-semibold text-indigo-600 hover:text-indigo-800">
                    + Créer votre première offre
                </a>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/80 border-b border-gray-200 text-[11px] font-bold uppercase tracking-wider text-gray-500">
                            <th class="py-3.5 px-6">Offre & Entreprise</th>
                            <th class="py-3.5 px-6">Lieu</th>
                            <th class="py-3.5 px-6">Contrat</th>
                            <th class="py-3.5 px-6">Candidatures</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        <% offres.forEach(item => { %>
                            <tr class="hover:bg-gray-50/50 transition">
                                <!-- Title & Company -->
                                <td class="py-4 px-6">
                                    <div class="font-bold text-gray-900 hover:text-indigo-600 transition">
                                        <a href="/offre/<%= item.id %>"><%= item.titre %></a>
                                    </div>
                                    <div class="text-xs text-gray-500 mt-0.5">
                                        <i class="fa-solid fa-building text-gray-400"></i> <%= item.entreprise || item.entreprise_nom || 'Non spécifié' %>
                                    </div>
                                </td>

                                <!-- Location -->
                                <td class="py-4 px-6 text-gray-600 font-medium text-xs">
                                    <i class="fa-solid fa-location-dot text-gray-400 mr-1"></i> <%= item.ville %>
                                </td>

                                <!-- Contract Badge -->
                                <td class="py-4 px-6">
                                    <span class="inline-block px-2.5 py-1 bg-indigo-50 text-indigo-700 font-bold text-[10px] rounded-md uppercase tracking-wider">
                                        <%= item.contrat || item.type_contrat || 'CDI' %>
                                    </span>
                                </td>

                                <!-- Applications Count -->
                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 text-emerald-700 font-semibold text-xs rounded-full border border-emerald-100">
                                        <i class="fa-solid fa-users text-[10px]"></i>
                                        <%= item.total_candidatures || 0 %> candidat(s)
                                    </span>
                                </td>

                                <!-- Actions Buttons -->
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/admin/offres/edit/<%= item.id %>" class="p-2 text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Modifier">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form action="/admin/offres/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette offre ?');" class="inline">
                                            <button type="submit" class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition" title="Supprimer">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

</main>

<%- include('../partials/footer') %>