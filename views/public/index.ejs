<%- include('../partials/header') %>

<style>
  .card-3d {
    background: #ffffff;
    border: 1px solid rgba(229, 231, 235, 0.8);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .card-3d:hover {
    transform: translateY(-4px) scale(1.005);
    box-shadow: 0 20px 30px -10px rgba(79, 70, 229, 0.15), 0 10px 15px -5px rgba(0, 0, 0, 0.04);
  }
  .search-3d {
    box-shadow: 0 20px 40px -15px rgba(99, 102, 241, 0.2);
  }
</style>

<section class="relative bg-gradient-to-b from-indigo-50/60 via-purple-50/40 to-gray-50 pt-16 pb-20 px-4 overflow-hidden">
  <div class="absolute -top-24 -left-20 w-96 h-96 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-indigo-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
      La plateforme #1 pour vos offres d'emploi
    </h1>
    <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto font-medium">
      Explorez les meilleures opportunités et développez votre carrière dès aujourd'hui.
    </p>

    <form action="/" method="GET" class="mt-10 bg-white/90 backdrop-blur-md p-2.5 rounded-2xl search-3d border border-white/80 flex flex-col md:flex-row items-center gap-2 max-w-3xl mx-auto">
      <div class="relative w-full md:w-1/2 flex items-center pl-3">
        <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <input type="text" name="search" value="<%= filters && filters.search ? filters.search : '' %>" placeholder="Poste, compétences ou entreprise" class="w-full bg-transparent border-none text-gray-800 placeholder-gray-400 text-sm focus:outline-none focus:ring-0">
      </div>

      <div class="hidden md:block w-px h-8 bg-gray-200"></div>

      <div class="relative w-full md:w-1/2 flex items-center pl-3">
        <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <input type="text" name="ville" value="<%= filters && filters.ville ? filters.ville : '' %>" placeholder="Ville ou région" class="w-full bg-transparent border-none text-gray-800 placeholder-gray-400 text-sm focus:outline-none focus:ring-0">
      </div>

      <button type="submit" class="w-full md:w-auto bg-black hover:bg-gray-800 text-white font-semibold px-8 py-3 rounded-xl text-sm transition-all duration-200 shadow-lg hover:shadow-black/20 active:scale-95">
        Rechercher
      </button>
    </form>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-8 space-y-6">
      <div class="flex items-center justify-between pb-2">
        <h2 class="text-lg font-bold text-gray-900">
          Résultats affichés (<%= offres ? offres.length : 0 %>)
        </h2>
        <span class="text-sm text-gray-500 font-medium">Trier par : <strong class="text-gray-800">Plus récents</strong></span>
      </div>

      <% if (offres && offres.length > 0) { %>
        <% offres.forEach(function(offre) { %>
          <% 
            var contratVal = offre.type_contrat || offre.contrat; 
            var villeVal = offre.entreprise_ville || offre.ville; 
            var nomEntreprise = offre.entreprise_nom || offre.entreprise || 'Entreprise';
            var dateVal = offre.created_at || offre.date_publication;
            var isValidDate = dateVal && dateVal !== '0000-00-00' && !isNaN(new Date(dateVal).getTime());
          %>
          <div class="card-3d rounded-2xl p-6 relative">
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-4">
                <% if (offre.entreprise_logo) { %>
                  <img src="<%= offre.entreprise_logo %>" alt="<%= nomEntreprise %>" class="w-12 h-12 rounded-xl object-cover border border-gray-100 shadow-md">
                <% } else { %>
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-indigo-200 flex-shrink-0">
                    <%= nomEntreprise.charAt(0).toUpperCase() %>
                  </div>
                <% } %>

                <div>
                  <h3 class="text-lg font-bold text-gray-900 hover:text-indigo-600 transition">
                    <a href="/offre/<%= offre.id %>"><%= offre.titre %></a>
                  </h3>
                  
                  <div class="flex items-center gap-2 mt-1 text-xs text-gray-500 font-medium flex-wrap">
                    <span class="text-gray-800 font-bold"><%= nomEntreprise %></span>
                    <span>•</span>
                    <span class="flex items-center gap-1 text-green-600 font-medium">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                      Vérifié
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <p class="mt-4 text-sm text-gray-600 line-clamp-2 leading-relaxed">
              <%= offre.description %>
            </p>

            <% if (offre.technologies || offre.competences) { %>
              <div class="mt-4 flex flex-wrap gap-1.5">
                <% 
                  var techs = [];
                  var rawTechs = offre.technologies || offre.competences;
                  if (Array.isArray(rawTechs)) {
                    techs = rawTechs;
                  } else if (typeof rawTechs === 'string') {
                    techs = rawTechs.split(',');
                  }
                %>
                <% techs.forEach(function(tech) { %>
                  <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2.5 py-1 rounded-md">
                    <%= tech.trim() %>
                  </span>
                <% }); %>
              </div>
            <% } %>

            <div class="mt-6 pt-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-2 flex-wrap text-xs font-semibold">
                <% if (contratVal) { %>
                  <span class="inline-flex items-center gap-1 bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg border border-indigo-100">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <%= contratVal %>
                  </span>
                <% } %>

                <% if (villeVal) { %>
                  <span class="inline-flex items-center gap-1 bg-gray-50 text-gray-700 px-3 py-1.5 rounded-lg border border-gray-200">
                    <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    <%= villeVal %>
                  </span>
                <% } %>

                <% if (offre.salaire) { %>
                  <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg border border-emerald-100 font-bold">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= offre.salaire %>
                  </span>
                <% } %>

                <% if (isValidDate) { %>
                  <span class="inline-flex items-center gap-1 text-gray-400 font-normal ml-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= new Date(dateVal).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) %>
                  </span>
                <% } %>
              </div>

              <a href="/offre/<%= offre.id %>" class="bg-black hover:bg-gray-800 text-white text-xs font-bold px-5 py-2.5 rounded-xl transition-all shadow-md active:scale-95 ml-auto">
                Postuler
              </a>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="card-3d rounded-2xl p-12 text-center">
          <p class="text-gray-500 font-medium">Aucune offre ne correspond à vos critères.</p>
        </div>
      <% } %>
    </div>

    <div class="lg:col-span-4">
      <div class="card-3d rounded-2xl p-6 sticky top-6">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-900 text-base">Filtres</h3>
          <a href="/" class="text-xs font-semibold text-indigo-600 hover:underline">Réinitialiser</a>
        </div>

        <form action="/" method="GET" class="mt-6 space-y-6">
          <input type="hidden" name="search" value="<%= filters && filters.search ? filters.search : '' %>">
          <input type="hidden" name="ville" value="<%= filters && filters.ville ? filters.ville : '' %>">

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-3">Type de contrat</label>
            <div class="space-y-2.5 text-sm text-gray-600">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="contrat" value="" <%= (!filters || !filters.contrat) ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">
                <span class="font-medium">Tous les contrats</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="contrat" value="CDI" <%= (filters && filters.contrat === 'CDI') ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">
                <span class="font-medium">CDI</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="contrat" value="CDD" <%= (filters && filters.contrat === 'CDD') ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">
                <span class="font-medium">CDD</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="contrat" value="Stage" <%= (filters && filters.contrat === 'Stage') ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">
                <span class="font-medium">Stage</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="contrat" value="Freelance" <%= (filters && filters.contrat === 'Freelance') ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">
                <span class="font-medium">Freelance</span>
              </label>
            </div>
          </div>

          <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl text-sm transition shadow-lg shadow-indigo-200 active:scale-95">
            Appliquer les filtres
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>