<%- include('../partials/header') %>
<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <% if ((typeof req !== 'undefined' && req.query && req.query.success) || (typeof success !== 'undefined' && success)) { %>
        <div class="mb-8 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl font-medium text-sm flex items-center shadow-sm">
            <i class="fa-solid fa-circle-check text-emerald-500 text-lg me-3"></i>
            <span>Votre candidature a été envoyée avec succès ! Bonne chance pour la suite.</span>
        </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-100 pb-6">
                    <div>
                        <span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-700 font-semibold text-xs rounded-full uppercase tracking-wider mb-2">
                            <%= offre.contrat || 'CDI' %>
                        </span>
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight">
                            <%= offre.titre %>
                        </h1>
                        <p class="text-gray-500 font-medium text-sm mt-1 flex items-center gap-2">
                            <span><i class="fa-solid fa-building text-gray-400"></i> <%= offre.entreprise %></span>
                            <span>•</span>
                            <span><i class="fa-solid fa-location-dot text-gray-400"></i> <%= offre.ville %></span>
                        </p>
                    </div>
                    <% if (offre.salaire) { %>
                        <div class="text-right">
                            <span class="text-xs text-gray-400 block font-medium">Rémunération</span>
                            <span class="text-lg font-bold text-indigo-600"><%= offre.salaire %></span>
                        </div>
                    <% } %>
                </div>
                <% if (offre.technologies) { %>
                    <div class="py-6 border-b border-gray-100">
                        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Compétences requises</h3>
                        <div class="flex flex-wrap gap-2">
                            <% 
                                const techArray = Array.isArray(offre.technologies) 
                                    ? offre.technologies 
                                    : offre.technologies.split(',').map(t => t.trim()); 
                            %>
                            <% techArray.forEach(tech => { %>
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg">
                                    <%= tech %>
                                </span>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
                <div class="pt-6">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">Description du poste</h3>
                    <div class="text-gray-600 leading-relaxed space-y-4 whitespace-pre-line text-sm sm:text-base">
                        <%= offre.description %>
                    </div>
                </div>

            </div>
        </div>
        <div class="lg:col-span-1">
            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 sticky top-24">
                <h2 class="text-xl font-bold text-gray-900 mb-2">Postuler à cette offre</h2>
                <p class="text-xs text-gray-500 mb-6">Remplissez le formulaire ci-dessous pour transmettre votre candidature.</p>

                <form action="/postuler/<%= offre.id %>" method="POST" enctype="multipart/form-data" class="space-y-4">
                    <div>
                        <label for="nom" class="block text-xs font-semibold text-gray-700 mb-1">Nom complet *</label>
                        <input type="text" id="nom" name="nom" required placeholder="Ex: Mohamed El Farh" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                    </div>
                    <div>
                        <label for="email" class="block text-xs font-semibold text-gray-700 mb-1">Adresse Email *</label>
                        <input type="email" id="email" name="email" required placeholder="votre.email@example.com" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                    </div>
                    <div>
                        <label for="telephone" class="block text-xs font-semibold text-gray-700 mb-1">Téléphone *</label>
                        <input type="tel" id="telephone" name="telephone" required placeholder="+212 600 000000" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                    </div>
                    <div>
                        <label for="cv" class="block text-xs font-semibold text-gray-700 mb-1">Curriculum Vitae (PDF) *</label>
                        <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" required 
                            class="w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer border border-gray-300 rounded-xl p-1">
                    </div>
                    <div>
                        <label for="message" class="block text-xs font-semibold text-gray-700 mb-1">Message (Optionnel)</label>
                        <textarea id="message" name="message" rows="3" placeholder="Présentez-vous brièvement..." 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm resize-none"></textarea>
                    </div>

                    <button type="submit" 
                        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-xl shadow-md hover:shadow-lg transition duration-200 text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Envoyer ma candidature
                    </button>
                </form>
            </div>
        </div>

    </div>
</main>

<%- include('../partials/footer') %>